  "sourceCode" : "public void put(int key, int value) {\n    int index = key % table.length;\n    Node node = table[index];\n    while (node != null) {\n        if (node.key == key) {\n            node.value = value;\n            return;\n        }\n        node = node.next;\n    }\n    table[index] = new Node(key, value, table[index]);\n    size++;\n}",
