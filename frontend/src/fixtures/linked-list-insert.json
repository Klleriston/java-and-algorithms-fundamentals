  "sourceCode" : "public void insert(int position, int value) {\n    if (position == 0) {\n        head = new Node(value, head);\n        return;\n    }\n    Node previous = head;\n    for (int i = 0; i < position - 1; i++) {\n        previous = previous.next;\n    }\n    Node node = new Node(value, previous.next);\n    previous.next = node;\n    size++;\n}",
