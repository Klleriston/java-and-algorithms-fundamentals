  "sourceCode" : "public Node insert(Node node, int value) {\n    if (node == null) {\n        return new Node(value);\n    }\n    if (value < node.value) {\n        node.left = insert(node.left, value);\n    } else if (value > node.value) {\n        node.right = insert(node.right, value);\n    }\n    return node;\n}",
